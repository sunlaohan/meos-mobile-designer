# 仅由服务端读取；密钥不要使用 VITE_ 前缀。复制为 .env.local 后填写。
DESIGNER_LLM_BASE_URL=https://sandbox.meos.center/bill-token-server/v1
DESIGNER_LLM_API_KEY=
DESIGNER_LLM_DEFAULT_MODEL=gemini-3.8-flash

# Supabase 项目连接；service_role 密钥只能放在服务端。
DESIGNER_SUPABASE_URL=
DESIGNER_SUPABASE_ANON_KEY=
DESIGNER_SUPABASE_SERVICE_KEY=
DESIGNER_PUBLIC_URL=http://localhost:4173

# 管理员密码存放 scrypt 哈希，格式为 salt:hex；不在源码中存放明文密码。
# 运行 node scripts/configure-admin.mjs 设置，用户名默认 admin。
DESIGNER_ADMIN_USERNAME=admin
DESIGNER_ADMIN_PASSWORD_HASH=
DESIGNER_ADMIN_SESSION_SECRET=
